#!/bin/bash

NAME=max6958-daemon.sh
DAEMON_PATH=/usr/local/bin
DAEMON=$DAEMON_PATH/$NAME
PIDFILE=/var/run/$NAME.pid
CHIP_ADDR=0x38

find_i2c_device() {
	for i2c_path in /sys/class/i2c-dev/i2c-*; do
		[ -d "$i2c_path" ] || continue

		bus=$(basename "$i2c_path" | sed 's/i2c-//')
		name_file="$i2c_path/name"

		if [ -f "$name_file" ] && grep -q "rk3x-i2c" "$name_file"; then
			if i2cdetect -y "$bus" "${CHIP_ADDR}" "${CHIP_ADDR}" | grep -q "${CHIP_ADDR#0x}"; then
				echo "$bus"
				return 0
			fi
		fi
	done

	return 1
}

start() {
	I2C_DEV=$(find_i2c_device)
	[ $? -ne 0 ] && return 1

	if [ -f $PIDFILE ]; then
		echo "Already running"
		return 1
	fi

	echo -n "Starting $NAME: "

	$DAEMON "$I2C_DEV" > /dev/null 2>&1 &
	PID=$!
	echo $PID > $PIDFILE
	echo "OK"
}

stop() {
	PID=$(cat $PIDFILE 2>/dev/null)
	[ ! -f $PIDFILE ] && return 1

	echo -n "Stopping $NAME: "

	kill -TERM "$PID" > /dev/null 2>&1
	rm -f $PIDFILE
	echo "OK"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 1
		start
		;;
	status)
		if [ -f $PIDFILE ]; then
			echo "Running (PID: $(cat $PIDFILE))"
		else
			echo "Stopped"
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac

exit 0
